# Copy to deploy/registry.env (git-ignored) and fill in. Sign in first with
# `docker login <registry>`; no credentials go here.

# Where the images go, without the image names.
REGISTRY=registry.example.com/khorde

# Optional.
# IMAGE_NAME=khorde-demo-hmi
# SIM_IMAGE_NAME=khorde-demo-sim
# PLATFORMS=linux/amd64
