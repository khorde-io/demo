        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "equipment",
        "driver"
      ],
      "type": "object"
    },
    "AgentCommand_for_ProtocolCommandDriver_for_Iec61850CommandAddress": {
      "description": "Authored / runtime command definition.",
      "properties": {
        "driver": {
          "$ref": "#/$defs/ProtocolCommandDriver_for_Iec61850CommandAddress"
        },
        "equipment": {
          "type": "string"
        },
        "interlock": {
          "anyOf": [
