    "AgentCommand_for_ProtocolCommandDriver_for_RestCommandAddress": {
      "description": "Authored / runtime command definition.",
      "properties": {
        "driver": {
          "$ref": "#/$defs/ProtocolCommandDriver_for_RestCommandAddress"
        },
        "equipment": {
          "type": "string"
        },
        "interlock": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterlockRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
