{
  "$defs": {
    "AgentCommand_for_ProtocolCommandDriver_for_Iec104CommandAddress": {
      "description": "Authored / runtime command definition.",
      "properties": {
        "driver": {
          "$ref": "#/$defs/ProtocolCommandDriver_for_Iec104CommandAddress"
        },
        "equipment": {
          "type": "string"
        },
        "interlock": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterlockRef"
