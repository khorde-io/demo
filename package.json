{
  "name": "khorde-demo-hmi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @khorde/demo-electrical",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
