    "accounts": [
      { "role": "viewer", "username": "viewer@example.com", "password": "<public password>" },
      { "role": "operator", "username": "operator@example.com", "password": "<public password>" },
      { "role": "supervisor", "username": "supervisor@example.com", "password": "<public password>" }
    ]
  }
}
